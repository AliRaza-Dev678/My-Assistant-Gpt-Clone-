# Copy to backend/.env for local development, or root .env for Docker Compose.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.2
DATABASE_URL=postgres://assistant:assistant@localhost:5432/ali_raza_assistant
GENERATE_SCHEMAS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LangSmith observability. Chat prompts and model responses are sent to the
# configured LangSmith project when tracing is enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ali-raza-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_INCLUDE_USER_EMAIL=false

# Optional Google Identity Services OAuth web client ID. Use the same value in
# the backend and frontend variables.
GOOGLE_CLIENT_ID=

# Docker Compose database settings. Change the password outside local development.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=ali_raza_assistant
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
